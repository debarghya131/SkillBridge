NODE_ENV=development
MONGO_URL=your_mongodb_connection_string
MONGO_DB_NAME=skillbridge
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=0
DB_MAX_IDLE_TIME_MS=30000
DB_SERVER_SELECTION_TIMEOUT_MS=10000
# Required in production. Use a random value of at least 32 characters.
VERIFICATION_HASH_SECRET=
REVIEW_CLAIM_TTL_MINUTES=240
MAX_REQUEST_BODY_BYTES=8000000
PORT=5000
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=30
MAX_SESSIONS_PER_ACCOUNT=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=12
DAILY_USER_RATE_LIMIT_MAX_REQUESTS=2000
DAILY_SECTION_OPERATION_LIMIT=2
LOG_LEVEL=info
